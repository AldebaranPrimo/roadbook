{
  "folders": [
    {
      "name": "Roadbook",
      "path": "."
    }
  ],
  "settings": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "files.eol": "\n",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.associations": {
      "*.vue": "vue"
    },
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/package-lock.json": true
    },
    "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#e7e7e799",
      "activityBar.background": "#47996b",
      "activityBar.foreground": "#e7e7e7",
      "activityBar.inactiveForeground": "#e7e7e799",
      "activityBarBadge.background": "#ffd54f",
      "activityBarBadge.foreground": "#15202b",
      "commandCenter.background": "#123622",
      "commandCenter.activeBackground": "#20603c",
      "commandCenter.activeBorder": "#e7e7e7",
      "commandCenter.foreground": "#e7e7e7",
      "commandCenter.activeForeground": "#e7e7e7",
      "commandCenter.inactiveForeground": "#e7e7e7cc",
      "commandCenter.border": "#e7e7e766",
      "commandCenter.inactiveBorder": "#e7e7e740",
      "modernActivityBarItem.activeBackground": "#e7e7e799",
      "modernActivityBarItem.activeForeground": "#47996b",
      "modernActivityBarItem.hoverBackground": "#5ca57c",
      "modernActivityBarItem.hoverForeground": "#e7e7e7",
      "sash.hoverBorder": "#47996b",
      "statusBar.background": "#2e8b57",
      "statusBar.foreground": "#e7e7e7",
      "statusBarItem.hoverBackground": "#47996b",
      "statusBarItem.hoverForeground": "#e7e7e7",
      "statusBarItem.remoteBackground": "#2e8b57",
      "statusBarItem.remoteForeground": "#e7e7e7",
      "statusBarItem.remoteHoverBackground": "#47996b",
      "statusBarItem.remoteHoverForeground": "#e7e7e7",
      "titleBar.activeBackground": "#18492e",
      "titleBar.activeForeground": "#e7e7e7",
      "titleBar.inactiveBackground": "#18492e99",
      "titleBar.inactiveForeground": "#e7e7e7b3"
    },
    "peacock.color": "#2e8b57"
  },
  "extensions": {
    "recommendations": [
      "Vue.volar",
      "ritwickdey.LiveServer",
      "EditorConfig.EditorConfig",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint"
    ]
  }
}
